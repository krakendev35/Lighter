{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lighter",
  "version": "0.1.0",
  "identifier": "com.lighter.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lighter",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "theme": "Dark",
        "backgroundColor": "#0d0d0d",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
